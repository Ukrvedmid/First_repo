TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ukrainian vacancy summaries.
# auto: use OpenAI when OPENAI_API_KEY is configured, otherwise use the built-in
# Ukrainian rule-based summary. The fallback works without any paid API.
JOB_SUMMARY_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
JOB_SUMMARY_TIMEOUT_SECONDS=45
JOB_SUMMARY_MAX_INPUT_CHARS=18000
